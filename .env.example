# Browser/client gateway URL (build-time — requires `npm run build` after changes)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Runtime gateway URL — takes effect on restart without a rebuild.
# Use this instead of NEXT_PUBLIC_GATEWAY_URL when you want to change the
# gateway endpoint without re-running `npm run build`.
# HERMES3D_GATEWAY_URL=ws://localhost:18789
# HERMES3D_GATEWAY_TOKEN=
# Optional: tell Studio which backend that runtime gateway URL represents.
# Valid values: hermes, hermes-agent, demo, custom
# HERMES3D_GATEWAY_ADAPTER_TYPE=hermes


# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=change-me-local-dev
# HERMES_MODEL=hermes-agent

# Debug UI
DEBUG=true

# App server
# PORT=3000
# HOST=127.0.0.1

# Optional: required only for public/remote deployments
# STUDIO_ACCESS_TOKEN=
# Advanced only: some gateway-host operations can still use SSH, but marketplace skill install does not require it.
# HERMES_GATEWAY_SSH_TARGET=
# HERMES_GATEWAY_SSH_USER=
# HERMES_GATEWAY_SSH_PORT=
# HERMES_GATEWAY_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Hermes Agent adapter (alternative to Hermes)
# Run `npm run hermes-adapter` to start the adapter, then connect Hermes3D to ws://localhost:18789
# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=
# HERMES_ADAPTER_PORT=18789
# HERMES_MODEL=hermes
# HERMES_AGENT_NAME=Hermes
# If HERMES3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# REVELARE Labs Runtime (private, 127.0.0.1 only)
# `npm run labs-runtime:init` creates the private folder and token outside the
# repo; `npm run labs-runtime` serves http://127.0.0.1:7770. In Studio choose
# "Custom backend" with URL http://127.0.0.1:7770.
# The proxy only sends the token when the allowlist is set.
# CUSTOM_RUNTIME_ALLOWLIST=127.0.0.1
# CUSTOM_RUNTIME_TOKEN_FILE=~/security-labs-private/runtime/token
# LABS_PROVIDER=claude   # or codex; overrides the private config.json

# Demo gateway (no Hermes or Hermes required)
# Run `npm run demo-gateway` and connect Hermes3D to ws://localhost:18789
# DEMO_ADAPTER_PORT=18789
# If HERMES3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Optional: voice features
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
